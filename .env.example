# Copy to .env. Environment variables take precedence over this file.
# --check validates settings without network calls or spending API credits.

# LLM: anthropic, ollama, groq, openrouter, openai, or a custom provider label.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_key_here

# For Ollama: set LLM_PROVIDER=ollama; no API key required.
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1

# For OpenAI-compatible services: choose a model available in your account.
# Known provider URLs (ollama/groq/openrouter/openai) are filled automatically.
# Custom provider labels require LLM_BASE_URL as well as LLM_MODEL.
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model-id

# Blank model uses the provider default for anthropic, ollama, and groq.
# OpenRouter, OpenAI, and custom providers require an explicit model.
LLM_MODEL=
LLM_MAX_TOKENS=150
# Number of complete user/assistant exchanges retained.
LLM_MAX_HISTORY=20
LLM_TIMEOUT=60

CHARACTER_NAME=Tulpa
# Blank uses the built-in persona. Quote multiline prompts in .env.
CHARACTER_SYSTEM_PROMPT=

# Internet access required for Edge TTS. Browse voices with edge-tts --list-voices.
TTS_VOICE=en-US-AnaNeural
TTS_PITCH=+0Hz
TTS_RATE=-5%
TTS_VOLUME=+0%
TTS_TIMEOUT=60

# VTube Studio is optional. Set 0 to run audio/subtitles only.
VTS_ENABLED=1
VTUBE_STUDIO_HOST=localhost
VTUBE_STUDIO_PORT=8001
VTS_PLUGIN_NAME=tulpamancer
VTS_TALKING_HOTKEY=
VTS_IDLE_HOTKEY=
# Tracking INPUT parameter, mapped to the model's mouth in VTube Studio.
VTS_MOUTH_PARAMETER=MouthOpen
VTS_TIMEOUT=2
VTS_AUTH_TIMEOUT=30

LIPSYNC_ENABLED=1
LIPSYNC_FPS=24
# Blank uses the OS temporary directory/tulpamancer_sub.txt.
SUBTITLE_PATH=

# Optional anonymous read-only chat; channel name, not URL.
TWITCH_CHANNEL=
SPEECH_INTERVAL=2.0
# Stop with an error after this many consecutive preparation failures.
MAX_GENERATION_FAILURES=3
RETRY_DELAY=10
AUDIO_TIMEOUT=300
