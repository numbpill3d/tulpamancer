# Copy to .env. Environment variables take precedence over this file.
# --check validates settings without network calls or spending API credits.

# LLM: anthropic, ollama, groq, openrouter, openai, or a custom provider label.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_key_here

# For Ollama: set LLM_PROVIDER=ollama; no API key required.
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1

# For OpenAI-compatible services: choose a model available in your account.
# Known provider URLs (ollama/groq/openrouter/openai) are filled automatically.
# Custom provider labels require LLM_BASE_URL as well as LLM_MODEL.
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model-id

# Blank model uses the provider default for anthropic, ollama, and groq.
# OpenRouter, OpenAI, and custom providers require an explicit model.
LLM_MODEL=
LLM_MAX_TOKENS=160
# Number of complete user/assistant exchanges retained.
LLM_MAX_HISTORY=8
LLM_TEMPERATURE=0.75
LLM_RAMBLE_INTERVAL_SECONDS=600
LLM_TIMEOUT=60

CHARACTER_NAME=Tulpa
# Blank uses the built-in persona. Quote multiline prompts in .env.
CHARACTER_SYSTEM_PROMPT=

# Internet access required for Edge TTS. Browse voices with edge-tts --list-voices.
TTS_VOICE=en-US-AnaNeural
TTS_PITCH=+0Hz
TTS_RATE=-5%
TTS_VOLUME=+0%
TTS_TIMEOUT=60

# VTube Studio is optional. Set 0 to run audio/subtitles only.
VTS_ENABLED=1
VTUBE_STUDIO_HOST=localhost
VTUBE_STUDIO_PORT=8001
VTS_PLUGIN_NAME=tulpamancer
VTS_TALKING_HOTKEY=
VTS_IDLE_HOTKEY=
# Optional comma-separated emotion=hotkey-id mappings from VTube Studio.
VTS_EMOTION_HOTKEYS=excited=,happy=,sad=,angry=,laugh=
# Optional named profiles. Auto mode discovers matching VTube Studio hotkeys.
VTS_EMOTE_HOTKEYS=wave=,laugh=,surprised=,confused=,excited=
VTS_AUTO_EMOTES=0
VTS_AUTO_FIDGETS=0
VTS_FIDGET_HOTKEYS=
VTS_FIDGET_MIN_SECONDS=25
VTS_FIDGET_MAX_SECONDS=55
# Standard VTube Studio tracking inputs; tune amplitude for the model.
VTS_IDLE_PARAMETERS=FaceAngleX=2,FaceAngleZ=1
# Tracking INPUT parameter, mapped to the model's mouth in VTube Studio.
VTS_MOUTH_PARAMETER=MouthOpen
VTS_TIMEOUT=2
VTS_AUTH_TIMEOUT=30

LIPSYNC_ENABLED=1
LIPSYNC_FPS=24
# Blank uses the OS temporary directory/tulpamancer_sub.txt.
SUBTITLE_PATH=

# Optional anonymous read-only chat; channel name, not URL.
TWITCH_CHANNEL=
# To let Tulpa send replies, configure a Twitch bot account and an OAuth token
# with chat:edit scope. Leave blank to keep output disabled.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_SEND_ENABLED=0
TWITCH_SEND_INTERVAL=5
# Optional input safety filters; comma-separated values.
TWITCH_IGNORED_USERS=
TWITCH_BLOCKED_TERMS=
TWITCH_MAX_MESSAGES_PER_MINUTE=30
SPEECH_INTERVAL=2.0
# Stop with an error after this many consecutive preparation failures.
MAX_GENERATION_FAILURES=3
RETRY_DELAY=10
AUDIO_TIMEOUT=300

# Local push-to-talk voice input. The tiny English model downloads on first use.
WHISPER_MODEL=tiny.en

# OBS WebSocket 5 setup (run: python src/main.py --setup-obs)
OBS_HOST=127.0.0.1
OBS_PORT=4455
# Optional for local OBS: the app can reuse OBS's local generated password.
OBS_PASSWORD=
OBS_SCENE=Tulpamancer
OBS_SUBTITLE_SOURCE=Tulpamancer Subtitles
OBS_TEXT_SOURCE_KIND=text_ft2_source_v2
OBS_AVATAR_SOURCE_NAME=Screen Capture (PipeWire)
OBS_BACKGROUND_SOURCE=Tulpamancer Background
OBS_ACCENT_SOURCE=Tulpamancer Red Accent
OBS_COLOR_SOURCE_KIND=color_source_v3
OBS_BACKGROUND_COLOR=0x050507FF
OBS_ACCENT_COLOR=0xD51F3FFF
OBS_AVATAR_KEY_COLOR=0xFFFFFF
OBS_AVATAR_KEY_FILTER=0
OBS_AUDIO_SOURCE_KIND=
OBS_AUDIO_SOURCE_NAME=
OBS_AUDIO_SOURCE_DEVICE=
OBS_TIMEOUT=5
